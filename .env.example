OPENAI_API_KEY=replace-with-your-server-side-key
ENGOLA_MODEL=gpt-5.6
ENGOLA_OWNER_NAME=Engola Innocent
ENGOLA_SETUP_TOKEN=replace-with-a-long-random-one-time-token
WEBAUTHN_RP_NAME=Engola
WEBAUTHN_RP_ID=your-domain.example
WEBAUTHN_ORIGIN=https://your-domain.example
COOKIE_SECURE=1
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=1800

# Optional: Google OAuth (leave blank to keep /api/google/* honestly disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/callback
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.readonly

# Optional: voice narration TTS synthesis (leave blank -> script only, no audio)
TTS_PROVIDER_API_KEY=

# Cold archive providers (comma-separated). Telegram is the default.
ENGOLA_ARCHIVE_PROVIDERS=telegram
ENGOLA_AUTO_ARCHIVE=1
ENGOLA_WORKER_ENABLED=1
ENGOLA_WORKER_INTERVAL_SECONDS=2
ENGOLA_TELEGRAM_BOT_TOKEN=
ENGOLA_TELEGRAM_ARCHIVE_CHAT_ID=
# Set this only if your Telegram Bot API endpoint has a different upload limit.
ENGOLA_TELEGRAM_MAX_BYTES=52428800
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ENGOLA_TTS_VOICE=en-GB-RyanNeural
ENGOLA_TTS_RATE=-4%
ENGOLA_TTS_PITCH=-2Hz
# v0.18 device agent
ENGOLA_AGENT_POLL_SECONDS=8
ENGOLA_AGENT_WORKDIR=
# Safe owner recovery: separate from setup authorization
ENGOLA_RECOVERY_TOKEN=

# Brave Search / LLM grounding
BRAVE_SEARCH_API_KEY=
